        "# ============================================================\n",
        "# PART 4: BUBBLE SORT - FIRST SIMPLE EXAMPLE\n",
        "# ============================================================\n",
        "print(\"\\n\\nBUBBLE SORT\")\n",
        "print(\"=\" * 40)\n",
        "numbers = [5, 3, 8, 1, 2]\n",
        "print(\"Before:\", numbers)\n",
        "n = len(numbers)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vW06QCNKp6Pp",
        "outputId": "4beddca9-8048-4757-aeeb-fa30af746f83"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "\n",
            "BUBBLE SORT\n",
            "========================================\n",
            "Before: [5, 3, 8, 1, 2]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Outer loop = number of passes\n",
        "for i in range(n):\n",
        "\n",
        "    # Inner loop = compare neighbouring elements\n",
        "    for j in range(0, n - i - 1):\n",
        "\n",
        "        # If left number is bigger\n",
        "        if numbers[j] > numbers[j + 1]:\n",
        "\n",
        "            # Swap\n",
        "            numbers[j], numbers[j + 1] = numbers[j + 1], numbers[j]\n",
        "\n",
        "print(\"After:\", numbers)"
      ],
      "metadata": {
