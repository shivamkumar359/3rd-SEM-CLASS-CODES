        "print(\"Starting list:\", numbers)\n",
        "\n",
        "n = len(numbers)\n",
        "\n",
        "for i in range(n):\n",
        "\n",
        "    print(\"\\nPass\", i + 1)\n",
        "\n",
        "    for j in range(0, n - i - 1):\n",
