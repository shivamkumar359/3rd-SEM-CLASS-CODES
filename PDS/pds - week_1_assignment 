        "# Check if a number is even or odd\n",
        "\n",
        "number = input(\"Enter a number: \")\n",
        "\n",
        "print(\"Before conversion:\", type(number))\n",
        "\n",
        "number = int(number)\n",
        "\n",
        "print(\"After conversion:\", type(number))\n",
        "\n",
        "if number % 2 == 0:\n",
        "    result = \"even\"\n",
        "else:\n",
        "    result = \"odd\"\n",
        "\n",
        "print(\"The number is {}.\".format(result))\n"
